Options -Indexes
RewriteEngine On

# Never expose environment or installation lock files.
<FilesMatch "^\\.">
    Require all denied
</FilesMatch>

# Send API paths to the PHP router while keeping uploaded media directly accessible.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
