{
  "openapi": "3.0.3",
  "info": { "title": "TheSex API", "version": "1.0.0", "description": "API da plataforma. Rotas administrativas e de membro usam cookies de sessão HTTP-only no mesmo domínio." },
  "servers": [{ "url": "/api/v1", "description": "Produção" }],
  "tags": [{ "name": "Público" }, { "name": "Membro" }, { "name": "Administração" }],
  "paths": {
    "/health": { "get": { "tags": ["Público"], "summary": "Status da API", "responses": { "200": { "description": "API disponível" } } } },
    "/profiles": { "get": { "tags": ["Público"], "summary": "Listar perfis publicados", "parameters": [{ "$ref": "#/components/parameters/q" }, { "$ref": "#/components/parameters/city" }, { "$ref": "#/components/parameters/category" }], "responses": { "200": { "$ref": "#/components/responses/ProfileList" } } }, "post": { "tags": ["Público"], "summary": "Enviar perfil para análise", "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/ProfileSubmission" } } } }, "responses": { "201": { "description": "Perfil enviado" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/profiles/{profileId}": { "get": { "tags": ["Público"], "summary": "Consultar perfil publicado", "parameters": [{ "$ref": "#/components/parameters/profileId" }], "responses": { "200": { "$ref": "#/components/responses/Profile" }, "404": { "description": "Perfil não encontrado" } } } },
    "/member/register": { "post": { "tags": ["Membro"], "summary": "Criar conta de membro", "requestBody": { "$ref": "#/components/requestBodies/MemberCredentials" }, "responses": { "201": { "description": "Conta criada" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/member/login": { "post": { "tags": ["Membro"], "summary": "Entrar como membro", "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "description": "Sessão de membro criada" } } } },
    "/member/logout": { "post": { "tags": ["Membro"], "summary": "Encerrar sessão", "security": [{ "memberSession": [] }], "responses": { "200": { "description": "Sessão encerrada" } } } },
    "/member/me": { "get": { "tags": ["Membro"], "summary": "Dados da conta atual", "security": [{ "memberSession": [] }], "responses": { "200": { "description": "Conta atual" } } } },
    "/member/dashboard": { "get": { "tags": ["Membro"], "summary": "Indicadores da conta", "security": [{ "memberSession": [] }], "responses": { "200": { "description": "Contagens por status" } } } },
    "/member/profiles": { "get": { "tags": ["Membro"], "summary": "Listar perfis da conta", "security": [{ "memberSession": [] }], "responses": { "200": { "$ref": "#/components/responses/ProfileList" } } } },
    "/member/profiles/{profileId}": { "patch": { "tags": ["Membro"], "summary": "Editar perfil próprio", "security": [{ "memberSession": [] }], "parameters": [{ "$ref": "#/components/parameters/profileId" }], "responses": { "200": { "$ref": "#/components/responses/Profile" } } } },
    "/member/profiles/{profileId}/status": { "patch": { "tags": ["Membro"], "summary": "Pausar ou reenviar perfil", "security": [{ "memberSession": [] }], "parameters": [{ "$ref": "#/components/parameters/profileId" }], "responses": { "200": { "$ref": "#/components/responses/Profile" } } } },
    "/member/settings": { "patch": { "tags": ["Membro"], "summary": "Atualizar preferências", "security": [{ "memberSession": [] }], "responses": { "200": { "description": "Preferências atualizadas" } } } },
    "/member/password": { "post": { "tags": ["Membro"], "summary": "Alterar senha", "security": [{ "memberSession": [] }], "responses": { "200": { "description": "Senha atualizada" } } } },
    "/admin/login": { "post": { "tags": ["Administração"], "summary": "Entrar no painel", "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "description": "Sessão administrativa criada" } } } },
    "/admin/logout": { "post": { "tags": ["Administração"], "summary": "Encerrar sessão administrativa", "security": [{ "adminSession": [] }], "responses": { "200": { "description": "Sessão encerrada" } } } },
    "/admin/me": { "get": { "tags": ["Administração"], "summary": "Administrador atual", "security": [{ "adminSession": [] }], "responses": { "200": { "description": "Administrador autenticado" } } } },
    "/admin/metrics": { "get": { "tags": ["Administração"], "summary": "Métricas operacionais", "security": [{ "adminSession": [] }], "responses": { "200": { "description": "Contagens de contas, perfis e autoaprovação" } } } },
    "/admin/audit": { "get": { "tags": ["Administração"], "summary": "Trilha de auditoria", "security": [{ "adminSession": [] }], "responses": { "200": { "description": "Últimas ações" } } } },
    "/admin/profiles": { "get": { "tags": ["Administração"], "summary": "Gerenciar fila de perfis", "security": [{ "adminSession": [] }], "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "active", "rejected", "archived", "all"] } }, { "$ref": "#/components/parameters/q" }], "responses": { "200": { "$ref": "#/components/responses/ProfileList" } } } },
    "/admin/profiles/{profileId}": { "patch": { "tags": ["Administração"], "summary": "Moderar, editar e configurar autoaprovação", "security": [{ "adminSession": [] }], "parameters": [{ "$ref": "#/components/parameters/profileId" }], "responses": { "200": { "$ref": "#/components/responses/Profile" } } } },
    "/admin/members": { "get": { "tags": ["Administração"], "summary": "Listar contas", "security": [{ "adminSession": [] }], "parameters": [{ "$ref": "#/components/parameters/q" }], "responses": { "200": { "description": "Contas com totais de perfis" } } } },
    "/admin/members/{memberId}": { "patch": { "tags": ["Administração"], "summary": "Editar conta", "security": [{ "adminSession": [] }], "parameters": [{ "name": "memberId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Conta atualizada" } } } },
    "/admin/password": { "post": { "tags": ["Administração"], "summary": "Alterar senha administrativa", "security": [{ "adminSession": [] }], "responses": { "200": { "description": "Senha atualizada" } } } }
  },
  "components": {
    "securitySchemes": { "adminSession": { "type": "apiKey", "in": "cookie", "name": "thesex_admin" }, "memberSession": { "type": "apiKey", "in": "cookie", "name": "thesex_member" } },
    "parameters": { "profileId": { "name": "profileId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, "q": { "name": "q", "in": "query", "schema": { "type": "string" } }, "city": { "name": "city", "in": "query", "schema": { "type": "string" } }, "category": { "name": "category", "in": "query", "schema": { "type": "string" } } },
    "requestBodies": { "Login": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } } }, "MemberCredentials": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemberCredentials" } } } } },
    "responses": { "Profile": { "description": "Perfil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileEnvelope" } } } }, "ProfileList": { "description": "Lista de perfis", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileListEnvelope" } } } }, "ValidationError": { "description": "Dados inválidos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } },
    "schemas": { "Login": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } } }, "MemberCredentials": { "allOf": [{ "$ref": "#/components/schemas/Login" }, { "type": "object", "properties": { "display_name": { "type": "string" }, "marketing_opt_in": { "type": "boolean" }, "adult_confirmed": { "type": "boolean" } } }] }, "ProfileSubmission": { "type": "object", "required": ["name", "age", "city", "price", "contact_phone", "photos[]", "adult_confirmed"], "properties": { "name": { "type": "string" }, "age": { "type": "integer", "minimum": 18 }, "category": { "type": "string" }, "city": { "type": "string" }, "price": { "type": "string" }, "contact_phone": { "type": "string" }, "photos[]": { "type": "array", "items": { "type": "string", "format": "binary" } }, "adult_confirmed": { "type": "boolean" } } }, "Profile": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "age": { "type": "integer" }, "status": { "type": "string" }, "city": { "type": "string" }, "photos": { "type": "array", "items": { "type": "string" } }, "auto_approved": { "type": "boolean" } } }, "ProfileEnvelope": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Profile" } } }, "ProfileListEnvelope": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } } } }, "Error": { "type": "object", "properties": { "error": { "type": "string" } } } }
  }
}
