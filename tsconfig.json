{
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/main.ts", "src/app.module.ts", "src/modules/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/routes", "src/components", "src/lib/api.ts", "src/router.tsx", "src/routeTree.gen.ts"]
}
